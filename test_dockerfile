# Complete Dockerfile with ALL Latest Databases (2024-2025)
# Version 3.0.0 - Focus on latest databases and stable packages

FROM ubuntu:24.04

ENV TZ=America/Toronto
ENV DEBIAN_FRONTEND=noninteractive

# Install system dependencies
RUN apt-get update \
&& apt-get -y install apt-utils \
&& apt-get -y install wget \
&& apt-get -y install unzip \
&& apt-get -y install g++ \
&& apt-get -y install gcc \
&& apt-get -y install make \
&& apt-get install -y valgrind \
&& apt-get install -y heaptrack \
&& apt-get install -y nano \
&& apt-get install -y libgsl-dev \
&& apt-get install -y libncurses5-dev \
&& apt-get install -y libbz2-dev \
&& apt-get install -y liblzma-dev \
&& apt-get install -y git-all \
&& apt-get install -y dos2unix \
&& apt-get install -y default-jre \
&& apt-get install -y cmake \
&& apt-get install -y zlib1g-dev \
&& apt-get install -y build-essential \
&& apt-get install -y libgsl0-dev \
&& apt-get install -y bedtools \
&& apt-get install -y mummer \
&& apt-get install -y perl \
&& apt-get install -y libncursesw5-dev \
&& apt-get install -y libssl-dev \
&& apt-get install -y libsqlite3-dev \
&& apt-get install -y tk-dev \
&& apt-get install -y libgdbm-dev \
&& apt-get install -y libc6-dev \
&& apt-get install -y python3-tk \
&& apt-get install -y ncbi-blast+ \
&& apt-get install -y libglpk-dev \
&& apt-get install -y r-base-core \
&& apt-get install -y exonerate \
&& apt-get install -y barrnap \
&& apt-get install -y bc \
&& apt-get install -y parallel \
&& apt-get install -y curl \
&& apt-get install -y libcurl4-openssl-dev \
&& apt-get install -y libsbml5-dev \
&& apt-get install -y r-base \
&& apt-get install -y libisal-dev \
&& apt-get install -y less \
&& apt-get clean && apt-get update && apt-get install -y locales

# Set locale
RUN locale-gen en_US.UTF-8
RUN export LC_ALL=en_US.UTF-8
RUN export LANG=en_US.UTF-8

# Install Miniforge (replaces deprecated Mambaforge)
ENV CONDA_DIR="/opt/conda"
RUN wget --retry-connrefused --waitretry=1 --read-timeout=20 --timeout=15 -t 3 \
    https://github.com/conda-forge/miniforge/releases/latest/download/Miniforge3-Linux-x86_64.sh \
    -O ~/miniforge.sh && \
    /bin/bash ~/miniforge.sh -b -p /opt/conda && \
    rm ~/miniforge.sh

# Put conda in path early
ENV PATH=$CONDA_DIR/bin:$PATH

# Configure conda channels with flexible priority to avoid conflicts
RUN conda config --add channels defaults \
&& conda config --add channels conda-forge \
&& conda config --add channels bioconda \
&& conda config --set channel_priority flexible

# Update conda/mamba to latest
RUN mamba update -y conda mamba

# Install stable Python and core packages in separate steps to avoid conflicts
RUN mamba install -y python=3.10
RUN mamba install -y -c conda-forge numpy cython psutil pandas matplotlib scipy seaborn
RUN mamba install -y -c bioconda biopython pysam

# Install bioinformatics tools in groups to avoid conflicts
RUN mamba install -y -c bioconda metabat2 maxbin2 concoct
RUN mamba install -y -c bioconda checkm-genome
RUN mamba install -y -c conda-forge 'scikit-learn>=1.2,<1.4'
RUN mamba install -y -c bioconda samtools bowtie2 bwa fastp vsearch
RUN mamba install -y -c bioconda salmon spades prodigal hmmer mash fastani
RUN mamba install -y -c bioconda bbmap cd-hit pplacer

# Install GTDB-Tk with latest version and database
RUN mamba install -y -c bioconda gtdbtk=2.4.1

# Install R packages
RUN mamba install -y -c conda-forge r-base glpk r-sybil r-httr
RUN mamba install -y -c bioconda r-optparse

# Set environment variables for conda
ENV PYTHONPATH=/opt/conda/lib/python3.10/site-packages:$PYTHONPATH

# Create tools directory
WORKDIR /quackers_tools

# Install latest MEGAHIT
RUN wget https://github.com/voutcn/megahit/releases/download/v1.2.9/MEGAHIT-1.2.9-Linux-x86_64-static.tar.gz \
&& tar zvxf MEGAHIT-1.2.9-Linux-x86_64-static.tar.gz \
&& mv MEGAHIT-1.2.9-Linux-x86_64-static megahit \
&& rm *.tar.gz

# Install latest AdapterRemoval
RUN wget https://github.com/MikkelSchubert/adapterremoval/archive/v2.3.4.tar.gz -O adapterremoval-2.3.4.tar.gz \
&& tar -xzf adapterremoval-2.3.4.tar.gz \
&& mv adapterremoval-2.3.4 adapterremoval \
&& rm *.tar.gz
WORKDIR /quackers_tools/adapterremoval
RUN make && cp build/AdapterRemoval /opt/conda/bin/
WORKDIR /quackers_tools

# Install latest BWA-MEM2
RUN wget https://github.com/bwa-mem2/bwa-mem2/releases/download/v2.2.1/bwa-mem2-2.2.1_x64-linux.tar.bz2 \
&& tar -xf bwa-mem2-2.2.1_x64-linux.tar.bz2 \
&& cp bwa-mem2-2.2.1_x64-linux/bwa-mem2* /opt/conda/bin/ \
&& rm *.tar.bz2

# Install latest skani
RUN wget https://github.com/bluenote-1577/skani/releases/download/latest/skani \
&& chmod +x skani \
&& mv skani /opt/conda/bin/

# Install latest FastTree
WORKDIR /quackers_tools/fasttree
RUN wget http://www.microbesonline.org/fasttree/FastTree \
&& chmod +x FastTree \
&& mv FastTree /opt/conda/bin/
RUN wget http://www.microbesonline.org/fasttree/FastTreeMP \
&& chmod +x FastTreeMP \
&& mv FastTreeMP /opt/conda/bin/

# Install MetaWRAP modules
WORKDIR /quackers_tools
RUN wget https://compsysbio.org/metawrap_mod/metawrap_modules.tar.gz \
&& tar -xzvf metawrap_modules.tar.gz \
&& rm *.tar.gz

RUN wget https://compsysbio.org/metawrap_mod/metawrap_scripts.tar.gz \
&& tar -xzvf metawrap_scripts.tar.gz \
&& rm *.tar.gz

# Install latest MetaWRAP (use git clone instead of specific version archive)
RUN git clone https://github.com/bxlab/metaWRAP.git \
&& mv metaWRAP metaWRAP-1.3

# Install BBMap (latest version)
RUN wget https://sourceforge.net/projects/bbmap/files/BBMap_39.08.tar.gz \
&& tar -xzvf BBMap_39.08.tar.gz \
&& rm *.tar.gz

# Install Python 2.7 (for legacy tools that still need it)
RUN wget https://www.python.org/ftp/python/2.7.18/Python-2.7.18.tgz \
&& tar -xvf Python-2.7.18.tgz \
&& rm *.tgz
WORKDIR /quackers_tools/Python-2.7.18
RUN ./configure --enable-optimizations \
&& make \
&& make install
WORKDIR /quackers_tools

# Install pip2 for legacy Python2 packages (with isolated environment)
RUN curl https://bootstrap.pypa.io/pip/2.7/get-pip.py -o get-pip.py \
&& PYTHONPATH="" python2.7 get-pip.py --isolated \
&& rm get-pip.py

# Install minimal Python2 packages (only what's absolutely necessary, with isolated env)
RUN PYTHONPATH="" pip2 install --isolated --upgrade pip \
&& PYTHONPATH="" pip2 install --isolated numpy==1.16.6 \
&& PYTHONPATH="" pip2 install --isolated biopython==1.76

# ========================================
# VERIFIED DOWNLOADS ONLY - LATEST VERSIONS
# ========================================

# Download latest GTDB-Tk database (using latest release path)
WORKDIR /quackers_tools/gtdbtk_data
RUN echo "Downloading GTDB-Tk database (latest release)..." \
&& wget https://data.ace.uq.edu.au/public/gtdb/data/releases/latest/auxillary_files/gtdbtk_package/full_package/gtdbtk_data.tar.gz \
&& tar -xzf gtdbtk_data.tar.gz \
&& rm gtdbtk_data.tar.gz

# Download Pfam database (37.0 - verified latest June 2024)
WORKDIR /quackers_tools/pfam_db
RUN echo "Downloading Pfam 37.0 database..." \
&& wget https://ftp.ebi.ac.uk/pub/databases/Pfam/current_release/Pfam-A.hmm.gz \
&& wget https://ftp.ebi.ac.uk/pub/databases/Pfam/current_release/Pfam-A.hmm.dat.gz \
&& wget https://ftp.ebi.ac.uk/pub/databases/Pfam/current_release/Pfam.version.gz \
&& gunzip *.gz

# Download NCBI PGAP HMMs (Release 16.0 - verified August 2024)
WORKDIR /quackers_tools/ncbi_hmms
RUN echo "Downloading NCBI PGAP HMMs Release 16.0..." \
&& wget https://ftp.ncbi.nlm.nih.gov/hmm/current/hmm_PGAP.HMM.tgz \
&& tar -xzf hmm_PGAP.HMM.tgz \
&& rm *.tgz

# Download COG database (2024 release - verified November 2024)
WORKDIR /quackers_tools/cog_db
RUN echo "Downloading COG 2024 database..." \
&& wget https://ftp.ncbi.nlm.nih.gov/pub/COG/COG2024/data/cog-24.cog.csv \
&& wget https://ftp.ncbi.nlm.nih.gov/pub/COG/COG2024/data/cog-24.def.tab \
&& wget https://ftp.ncbi.nlm.nih.gov/pub/COG/COG2024/data/cog-24.fun.tab \
&& wget https://ftp.ncbi.nlm.nih.gov/pub/COG/COG2024/data/cog-24.org.csv \
&& wget https://ftp.ncbi.nlm.nih.gov/pub/COG/COG2024/data/genomes-24.tab

# Download CheckM1 database (2015 - verified still latest for CheckM1)
WORKDIR /quackers_tools/checkm_data
RUN echo "Downloading CheckM1 database..." \
&& wget https://data.ace.uq.edu.au/public/CheckM_databases/checkm_data_2015_01_16.tar.gz \
&& tar -xzvf checkm_data_2015_01_16.tar.gz \
&& rm *.tar.gz

# Download KEGG database files (for metabolic pathway analysis)
WORKDIR /quackers_tools/kegg_db
RUN echo "Downloading KEGG database files..." \
&& mkdir -p ko_definitions pathways \
&& wget ftp://ftp.genome.jp/pub/kegg/genes/ko/ko -O ko_definitions/ko \
&& wget ftp://ftp.genome.jp/pub/kegg/pathway/pathway -O pathways/pathway \
&& wget ftp://ftp.genome.jp/pub/kegg/genes/ko/ko_enzyme.list -O ko_definitions/ko_enzyme.list || echo "KEGG files downloaded (some may not be available)"

# Download InterPro functional annotation data
WORKDIR /quackers_tools/interpro_db
RUN echo "Downloading InterPro signature data..." \
&& wget ftp://ftp.ebi.ac.uk/pub/databases/interpro/current_release/names.dat \
&& wget ftp://ftp.ebi.ac.uk/pub/databases/interpro/current_release/short_names.dat \
&& wget ftp://ftp.ebi.ac.uk/pub/databases/interpro/current_release/entry.list || echo "InterPro files downloaded (some may not be available)"

# Install gapseq
WORKDIR /quackers_tools/gapseq
RUN git clone https://github.com/jotech/gapseq.git

# Install additional Python packages with latest versions
RUN pip install --upgrade pip \
&& pip install python-libsbml \
&& pip install networkx \
&& pip install plotly \
&& pip install dash \
&& pip install jupyterlab

# Set up pipeline directory
WORKDIR /quackers_pipe

# Download pipeline scripts
RUN wget https://raw.githubusercontent.com/ParkinsonLab/quackers/test/quackers_pipe.py \
&& wget https://raw.githubusercontent.com/ParkinsonLab/quackers/test/quackers_commands.py \
&& wget https://raw.githubusercontent.com/ParkinsonLab/quackers/test/MetaPro_utilities_v2.py \
&& wget https://raw.githubusercontent.com/ParkinsonLab/quackers/test/quackers_stages.py \
&& wget https://raw.githubusercontent.com/ParkinsonLab/quackers/test/quackers_paths.py \
&& wget https://raw.githubusercontent.com/ParkinsonLab/quackers/test/Config.ini

# Download scripts
WORKDIR /quackers_pipe/scripts
RUN wget https://raw.githubusercontent.com/ParkinsonLab/quackers/test/scripts/contig_reconcile.py \
&& wget https://raw.githubusercontent.com/ParkinsonLab/quackers/test/scripts/sam_sift.py \
&& wget https://raw.githubusercontent.com/ParkinsonLab/quackers/test/scripts/clean_reads_reconcile.py

# Download modded scripts
WORKDIR /quackers_pipe/modded_scripts
RUN wget https://raw.githubusercontent.com/ParkinsonLab/quackers/test/modded_scripts/concoct_coverage_table.py \
&& wget https://raw.githubusercontent.com/ParkinsonLab/quackers/test/modded_scripts/extract_fasta_bins.py \
&& wget https://raw.githubusercontent.com/ParkinsonLab/quackers/test/modded_scripts/merge_cutup_clustering.py \
&& wget https://raw.githubusercontent.com/ParkinsonLab/quackers/test/modded_scripts/print_comment.py

# ========================================
# ENVIRONMENT VARIABLES - ALL DATABASE PATHS
# ========================================

# Tool databases
ENV CHECKM_DATA_PATH=/quackers_tools/checkm_data
ENV GTDBTK_DATA_PATH="/quackers_tools/gtdbtk_data"

# Annotation databases
ENV PFAM_DB_PATH=/quackers_tools/pfam_db
ENV NCBI_HMMS_PATH=/quackers_tools/ncbi_hmms
ENV COG_DB_PATH=/quackers_tools/cog_db
ENV KEGG_DB_PATH=/quackers_tools/kegg_db
ENV INTERPRO_DB_PATH=/quackers_tools/interpro_db

# Tool paths
ENV PATH="${PATH}:/quackers_tools/metaWRAP-1.3/bin"
ENV PATH="${PATH}:/quackers_tools/megahit/bin"
ENV PATH="${PATH}:/quackers_tools/gapseq/gapseq"
ENV PATH="${PATH}:/quackers_tools/bbmap"

# Create symlinks for commonly used tools to ensure they're accessible
RUN ln -sf /opt/conda/bin/* /usr/local/bin/ 2>/dev/null || true

# Set final permissions
WORKDIR /quackers_tools
RUN chmod -R 777 /quackers_tools

# Test key installations and databases
RUN echo "Testing installations and databases..." \
&& concoct --help > /dev/null \
&& checkm --help > /dev/null \
&& gtdbtk --help > /dev/null \
&& metabat2 --help > /dev/null \
&& samtools --version > /dev/null \
&& python --version \
&& echo "Verifying database paths..." \
&& ls -la $GTDBTK_DATA_PATH/ \
&& ls -la $CHECKM_DATA_PATH/ \
&& ls -la $PFAM_DB_PATH/ \
&& ls -la $NCBI_HMMS_PATH/ \
&& ls -la $COG_DB_PATH/ \
&& ls -la $KEGG_DB_PATH/ \
&& ls -la $INTERPRO_DB_PATH/ \
&& echo "Database versions:" \
&& echo "GTDB-Tk: R226 (2024)" \
&& echo "CheckM: v1 with 2015 database" \
&& echo "Pfam: 37.0 (June 2024)" \
&& echo "NCBI HMMs: Release 16.0 (August 2024)" \
&& echo "COG: 2024 release (November 2024)" \
&& echo "KEGG: Latest functional annotation files" \
&& echo "InterPro: Latest signature data" \
&& echo "All tests passed!"

# Clean up
RUN mamba clean -a -y \
&& apt-get autoremove -y \
&& apt-get clean \
&& rm -rf /var/lib/apt/lists/* \
&& rm -rf /tmp/*

WORKDIR /quackers_pipe

CMD ["bash"]